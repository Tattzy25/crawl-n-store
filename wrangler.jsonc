{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crawl-n-store",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp"]
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "crawl-n-store"
    }
  ]
}
